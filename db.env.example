# Скопируй в db.env и задай собственные значения.
# Эти значения нужны PostgreSQL только для первичной инициализации.
POSTGRES_DB=appdb
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

# Эти учётные данные приложения должны совпадать с секретом в Vault.
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
