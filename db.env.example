# Пример env-файла БД. Скопируй в db.env и задай собственные значения.
# db.env не коммитится: это единственное место, где живут пароли PostgreSQL.
POSTGRES_DB=appdb
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

# Учётные данные приложения (используются только при первичной инициализации
# кластера, в коде и в репозитории их нет).
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
