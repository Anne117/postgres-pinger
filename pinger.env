# Example env for Docker / docker-compose (Задание №2).
# Копируется в compose через env_file.

# Период опроса БД, секунд (пункт 1.5).
PINGER_INTERVAL=300

# Таймаут подключения, секунд — защита от зависания при сетевых проблемах.
PINGER_CONNECT_TIMEOUT=10

# Логин и пароль (пункт 1.6).
PGUSER=app_user
PGPASSWORD=user_secret

# Путь к файлу для дублирования логов (пункт 1.7), необязателен.
PINGER_LOG_FILE=/var/log/pinger.log

# Необязательные переопределения конфига (обычно не нужны, host="db" из app.conf).
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=appdb
