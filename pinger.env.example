# Пример env-файла пингера. Скопируй в pinger.env. Не коммить заполненный файл!
PINGER_INTERVAL=300
PINGER_CONNECT_TIMEOUT=10
PINGER_LOG_FILE=/var/log/pinger.log

# Логин и пароль БД (пункт 1.6). Пароль должен совпадать с APP_DB_PASSWORD из db.env.
PGUSER=app_user
PGPASSWORD=CHANGE_ME_APP_DB_PASSWORD
